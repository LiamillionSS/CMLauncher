		<style>*{border:0;font-family:Arial,serif;color:#DDD;text-align:center}html{background-color:#2F3136}img{display:block;margin:auto;max-width: 100%}ul{list-style-type:none;padding:0}li{margin:auto;width:300px;text-align:center}.button{box-shadow:inset 0 1px 0 0 #54a3f7;background-color:#007dc1;border-radius:3px;border:1px solid #124d77;display:inline-block;cursor:pointer;color:#fff;font-size:18px;padding:8px 50px;text-decoration:none;text-shadow:0 1px 0 #154682;margin:0 auto 20px auto}.button:hover{background-color:#0061a7}.button:active{position:relative;top:1px}.warn-button{box-shadow:inset 0 1px 0 0 #fff6af;background-color:#ffec64;border:1px solid #d6c50d;color:#333;text-shadow:0 1px 0 #fe6}.warn-button:hover{background-color:#ffe438}div{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}a{text-decoration:none;margin:12px}a svg{width:64px;height:64px}.linux-button{box-shadow:inset 0 1px 0 0 #90f0aa;background-color:#32a852;border:1px solid #159438;color:#333;text-shadow:0 1px 0 #258f42}.linux-button:hover{background-color:#0ad141}small{display:block;margin-top:-10px}footer{text-align:center;padding-top:160px}</style>
